<Entity name="pul_belt_lantern" tags="pul_belt" >

    <!--
        Belt lantern visual, spawned by files/scripts/lantern_belt.lua as a child of the player.
        The sprite, light and fog of war hole are added from Lua, copied from the carried lantern.
    -->

    <!-- Follows the player belt hotspot; rotation and scale stay free for the sway script and mirroring. -->
    <InheritTransformComponent
        parent_hotspot_tag="belt_root"
        only_position="1"
    >
        <Transform
            position.x="0"
            position.y="0"
        ></Transform>
    </InheritTransformComponent>

    <!-- Same pendulum as the lantern in hand, driven by the player velocity. -->
    <LuaComponent
        execute_every_n_frame="1"
        script_source_file="mods/pick_up_your_lantern/files/scripts/lantern_in_hand.lua"
    ></LuaComponent>

</Entity>
