<Entity name="pul_study_marker" tags="pul_study_marker" >

    <!--
        Enemy study marker, attached by files/scripts/enemy_study.lua as a child of a studied enemy.
        Yellow dot: the enemy is being studied, red: study is paused (out of light or sight), green: fully studied.
        The size and the height above the head are set from Lua through the sprite scale and offset.
    -->

    <!-- Follows the enemy position only, so the dot stays upright when the enemy flips or rotates. -->
    <InheritTransformComponent
        only_position="1"
    >
        <Transform
            position.x="0"
            position.y="0"
        ></Transform>
    </InheritTransformComponent>

    <SpriteComponent
        _tags="pul_study_in_progress"
        image_file="mods/pick_up_your_lantern/files/ui_gfx/study_dot_yellow.png"
        offset_x="2"
        offset_y="2"
        alpha="0.5"
        emissive="1"
        z_index="-1"
    ></SpriteComponent>

    <SpriteComponent
        _tags="pul_study_paused"
        _enabled="0"
        image_file="mods/pick_up_your_lantern/files/ui_gfx/study_dot_red.png"
        offset_x="2"
        offset_y="2"
        alpha="0.5"
        emissive="1"
        z_index="-1"
    ></SpriteComponent>

    <SpriteComponent
        _tags="pul_study_done"
        _enabled="0"
        image_file="mods/pick_up_your_lantern/files/ui_gfx/study_dot_green.png"
        offset_x="2"
        offset_y="2"
        alpha="0.5"
        emissive="1"
        z_index="-1"
    ></SpriteComponent>

</Entity>
