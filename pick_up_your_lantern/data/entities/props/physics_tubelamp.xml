<Entity tags="mortal,hittable,teleportable_NOT,prop,prop_physics,item_physics,item_pickup,lantern,pul_light_source" >

    <!-- mortal is required so it can explode -->

    <PhysicsBodyComponent
        _tags="enabled_in_world"
        allow_sleep="1"
        angular_damping="0.01"
        fixed_rotation="0"
        gridworld_box2d="1"
        hax_fix_going_through_ground="1"
        is_bullet="1"
        linear_damping="0.1"
        auto_clean="0"
        on_death_leave_physics_body="0"
        on_death_really_leave_body="0"
    ></PhysicsBodyComponent>

    <!-- One body instead of the vanilla tube and two wires: the wire stubs are drawn on top of the tube.
         Origin at the top of the wires, so the lamp hangs 2 px below the ceiling. -->
    <PhysicsImageShapeComponent
        centered="0"
        offset_x="9.5"
        offset_y="0.5"
        image_file="mods/pick_up_your_lantern/files/props_gfx/tube_lamp.png"
        material="glass_box2d"
    ></PhysicsImageShapeComponent>

    <PhysicsJointComponent
        nail_to_wall="1"
        breakable="1"
        pos_x="9.5"
        pos_y="-2"
    ></PhysicsJointComponent>

    <LuaComponent
        _tags="enabled_in_world"
        execute_every_n_frame="20"
        script_source_file="mods/pick_up_your_lantern/files/scripts/lantern_anchor.lua"
        script_kick="mods/pick_up_your_lantern/files/scripts/lantern_anchor.lua"
    ></LuaComponent>

    <LuaComponent
        _tags="enabled_in_world"
        execute_every_n_frame="1"
        script_source_file="mods/pick_up_your_lantern/files/scripts/lantern_in_world.lua"
    ></LuaComponent>

    <!-- Base light of this lantern type. Radius is scaled at runtime by settings, quality tier and modifier.
         Replaces the two vanilla lights (radius 150, 6 px left and right of the centre): the mod scales one light. -->
    <LightComponent
        _tags="enabled_in_world,enabled_in_hand,pul_light_source"
        _enabled="1"
        radius="200"
        r="200"
        g="230"
        b="255"
        update_properties="1"
    ></LightComponent>

    <!-- Base fog of war hole of this lantern type. Removed on init when dynamic lighting is disabled. -->
    <SpriteComponent
        _tags="enabled_in_world,enabled_in_hand"
        _enabled="1"
        alpha="0.55"
        image_file="data/particles/fog_of_war_hole_64.xml"
        smooth_filtering="1"
        fog_of_war_hole="1"
        has_special_scale="1"
        special_scale_x="1"
        special_scale_y="1"
    ></SpriteComponent>

    <DamageModelComponent
        _tags="enabled_in_world"
        air_needed="0"
        blood_material=""
        drop_items_on_death="0"
        falling_damage_damage_max="1.2"
        falling_damage_damage_min="0.1"
        falling_damage_height_max="250"
        falling_damage_height_min="70"
        falling_damages="0"
        fire_damage_amount="0.2"
        fire_probability_of_ignition="0"
        critical_damage_resistance="1"
        hp="0.7"
        is_on_fire="0"
        materials_create_messages="0"
        materials_damage="0"
        ragdoll_filenames_file=""
        ragdoll_material=""
        ui_report_damage="0"
    ></DamageModelComponent>

    <ExplodeOnDamageComponent
        _tags="enabled_in_world"
        explode_on_death_percent="1"
        explode_on_damage_percent="0.0"
        physics_body_modified_death_probability="0"
        physics_body_destruction_required="0.6"
    >
        <config_explosion
            never_cache="0"
            damage="1"
            camera_shake="5"
            explosion_radius="10"
            explosion_sprite="data/particles/explosion_016_electric.xml"
            explosion_sprite_lifetime="8"
            create_cell_probability="10"
            create_cell_material="spark_electric"
            hole_destroy_liquid="0"
            hole_enabled="1"
            ray_energy="100000"
            particle_effect="1"
            damage_mortals="1"
            physics_explosion_power.min="0.08"
            physics_explosion_power.max="0.15"
            physics_throw_enabled="1"
            shake_vegetation="1"
            sparks_count_max="10"
            sparks_count_min="5"
            sparks_enabled="1"
            stains_enabled="1"
            stains_radius="10"
        ></config_explosion>
    </ExplodeOnDamageComponent>

    <PhysicsBodyCollisionDamageComponent
        _tags="enabled_in_world"
        speed_threshold="80.0"
    ></PhysicsBodyCollisionDamageComponent>

    <CameraBoundComponent
        _tags="enabled_in_world"
        max_count="100"
        distance="1000"
    ></CameraBoundComponent>

    <LuaComponent script_death="mods/pick_up_your_lantern/files/scripts/tube_lamp_death.lua" />

    <LuaComponent script_damage_received="mods/pick_up_your_lantern/files/scripts/lantern_damage.lua" />

    <LuaComponent
        script_throw_item="mods/pick_up_your_lantern/files/scripts/lantern_throw.lua"
        execute_every_n_frame="-1"
    ></LuaComponent>

    <AudioComponent
        _tags="enabled_in_world"
        file="data/audio/Desktop/materials.bank"
        event_root="collision/lantern"
        set_latest_event_position="1"
    ></AudioComponent>

    <PhysicsThrowableComponent
        max_throw_speed="180"
        throw_force_coeff="1.5"
    ></PhysicsThrowableComponent>

    <ProjectileComponent
        _tags="enabled_in_world"
        lifetime="-1"
        damage="0"
        penetrate_entities="1"
        never_hit_player="1"
    ></ProjectileComponent>

    <VelocityComponent
        _tags="enabled_in_world"
    ></VelocityComponent>

    <SpriteComponent
        _tags="character,enabled_in_hand"
        _enabled="0"
        alpha="1"
        image_file="mods/pick_up_your_lantern/files/props_gfx/tube_lamp_in_hand.xml"
        offset_x="9.5"
        offset_y="0.5"
        emissive="0"
        additive="0"
        next_rect_animation=""
        rect_animation="default"
        z_index="-1.1"
        has_special_scale="1"
        special_scale_x="1"
        special_scale_y="1"
    ></SpriteComponent>

    <ItemComponent
        _tags="enabled_in_world"
        item_name="$item_tube_lamp"
        ui_description="$item_description_tube_lamp"
        ui_sprite="mods/pick_up_your_lantern/files/props_gfx/ui_tube_lamp.png"
        max_child_items="0"
        is_pickable="1"
        is_equipable_forced="1"
        preferred_inventory="QUICK"
        drinkable="0"
    ></ItemComponent>

    <UIInfoComponent
        _tags="enabled_in_world"
        name="$item_tube_lamp"
    ></UIInfoComponent>

    <AbilityComponent
        ui_name="$item_tube_lamp"
        throw_as_item="1"
    >
        <gun_config deck_capacity="0" />
    </AbilityComponent>

    <VariableStorageComponent
        _tags="enabled_in_world,enabled_in_hand,enabled_in_inventory"
        name="lantern_swing_angle"
        value_float="0"
    ></VariableStorageComponent>

    <VariableStorageComponent
        _tags="enabled_in_world,enabled_in_hand,enabled_in_inventory"
        name="lantern_swing_vel"
        value_float="0"
    ></VariableStorageComponent>

    <VariableStorageComponent
        _tags="enabled_in_world,enabled_in_hand,enabled_in_inventory"
        name="lantern_swing_phase"
        value_float="0"
    ></VariableStorageComponent>

    <LuaComponent
        _tags="enabled_in_hand"
        _enabled="0"
        execute_every_n_frame="1"
        script_source_file="mods/pick_up_your_lantern/files/scripts/lantern_in_hand.lua"
    ></LuaComponent>

</Entity>

