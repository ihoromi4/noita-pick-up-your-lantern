<Entity tags="mortal,hittable,teleportable_NOT,prop,prop_physics,item_physics,item_pickup,lantern,pul_light_source" >

    <!-- mortal is required so it can explode -->

    <PhysicsBodyComponent
        _tags="enabled_in_world"
        allow_sleep="1"
        angular_damping="0.01"
        fixed_rotation="0"
        gridworld_box2d="1"
        hax_fix_going_through_ground="1"
        is_bullet="1"
        linear_damping="0.3"
        auto_clean="0"
        on_death_leave_physics_body="0"
        on_death_really_leave_body="0"
    ></PhysicsBodyComponent>

    <!-- Origin at the top of the lantern, in the middle, where the vanilla chain is attached. -->
    <PhysicsImageShapeComponent
        centered="0"
        offset_x="4.5"
        offset_y="0.5"
        image_file="data/props_gfx/temple_lantern_01.png"
        material="metal_nohit"
    ></PhysicsImageShapeComponent>

    <!-- Holds a lantern hung with the left mouse button. A lantern spawned by a biome is far below the ceiling:
         lantern_chain.lua removes this joint and hangs it on a chain. -->
    <PhysicsJointComponent
        nail_to_wall="1"
        breakable="1"
        pos_x="4.5"
        pos_y="1"
    ></PhysicsJointComponent>

    <LuaComponent
        _tags="enabled_in_world"
        execute_every_n_frame="20"
        script_source_file="mods/pick_up_your_lantern/files/scripts/lantern_anchor.lua"
        script_kick="mods/pick_up_your_lantern/files/scripts/lantern_anchor.lua"
    ></LuaComponent>

    <!-- Kicked off its chain. -->
    <LuaComponent
        _tags="enabled_in_world"
        execute_every_n_frame="-1"
        script_kick="mods/pick_up_your_lantern/files/scripts/lantern_chain_kick.lua"
    ></LuaComponent>

    <LuaComponent
        _tags="enabled_in_world"
        execute_every_n_frame="1"
        script_source_file="mods/pick_up_your_lantern/files/scripts/lantern_in_world.lua"
    ></LuaComponent>

    <!-- Base light of this lantern type. Radius is scaled at runtime by settings, quality tier and modifier.
         Half as wide as vanilla (128), and brighter: the light has no intensity, so red and green are raised
         from the vanilla 30 while blue stays at its maximum. -->
    <LightComponent
        _tags="enabled_in_world,enabled_in_hand,pul_light_source"
        _enabled="1"
        radius="192"
        fade_out_time="1.5"
        r="80"
        g="100"
        b="255"
        update_properties="1"
    ></LightComponent>

    <!-- Base fog of war hole of this lantern type. Removed on init when dynamic lighting is disabled. -->
    <SpriteComponent
        _tags="enabled_in_world,enabled_in_hand"
        _enabled="1"
        alpha="0.55"
        image_file="data/particles/fog_of_war_hole_64.xml"
        smooth_filtering="1"
        fog_of_war_hole="1"
        has_special_scale="1"
        special_scale_x="0.8"
        special_scale_y="0.8"
    ></SpriteComponent>

    <!-- Plasma glow and sparks of the vanilla lantern, removed when it goes out. -->
    <ParticleEmitterComponent
        _tags="enabled_in_world,enabled_in_hand"
        emitted_material_name="plasma_fading_bright"
        fade_based_on_lifetime="1"
        x_pos_offset_min="-2"
        x_pos_offset_max="2"
        y_pos_offset_min="3"
        y_pos_offset_max="7"
        x_vel_min="-80"
        x_vel_max="80"
        y_vel_min="-0"
        y_vel_max="0"
        attractor_force="15"
        gravity.y="-15"
        friction="-0.1"
        airflow_force="1.9"
        airflow_time="0.101"
        airflow_scale="0.81"
        count_min="1"
        count_max="2"
        lifetime_min="1.0"
        lifetime_max="5.0"
        create_real_particles="0"
        emit_cosmetic_particles="1"
        collide_with_grid="0"
        render_on_grid="1"
        emission_interval_min_frames="10"
        emission_interval_max_frames="90"
        is_emitting="1"
    ></ParticleEmitterComponent>

    <SpriteParticleEmitterComponent
        _tags="enabled_in_world,enabled_in_hand"
        sprite_file="data/particles/tinyspark_03.xml"
        additive="1"
        color.a="0.5"
        gravity.y="-30"
        velocity_slowdown="0"
        rotation="0"
        angular_velocity="0"
        use_velocity_as_rotation="0"
        emission_interval_min_frames="9"
        emission_interval_max_frames="9"
        count_min="1"
        count_max="1"
        randomize_rotation.min="-0.3415"
        randomize_rotation.max="0.3415"
        randomize_angular_velocity.min="-0.1"
        randomize_angular_velocity.max="0.1"
        randomize_position.min_x="-1"
        randomize_position.max_x="2"
        randomize_position.min_y="2"
        randomize_position.max_y="6"
        randomize_velocity.min_x="-3"
        randomize_velocity.max_x="3"
        randomize_velocity.min_y="-3"
        randomize_velocity.max_y="3"
    ></SpriteParticleEmitterComponent>

    <DamageModelComponent
        _tags="enabled_in_world"
        air_needed="0"
        blood_material="plasma_fading"
        drop_items_on_death="0"
        falling_damage_damage_max="1.2"
        falling_damage_damage_min="0.1"
        falling_damage_height_max="250"
        falling_damage_height_min="70"
        falling_damages="0"
        fire_damage_amount="0.2"
        fire_probability_of_ignition="0"
        critical_damage_resistance="1"
        hp="0.15"
        is_on_fire="0"
        materials_create_messages="0"
        materials_damage="0"
        ragdoll_filenames_file=""
        ragdoll_material=""
        ui_report_damage="0"
    ></DamageModelComponent>

    <ExplodeOnDamageComponent
        _tags="enabled_in_world"
        explode_on_death_percent="1"
        explode_on_damage_percent="0.0"
        physics_body_modified_death_probability="0.75"
        physics_body_destruction_required="0.5"
    >
        <config_explosion
            never_cache="0"
            damage="0.2"
            camera_shake="1"
            explosion_radius="5"
            explosion_sprite="data/particles/explosion_008.xml"
            explosion_sprite_lifetime="8"
            create_cell_probability="50"
            hole_destroy_liquid="0"
            hole_enabled="1"
            ray_energy="10000"
            particle_effect="1"
            damage_mortals="1"
            physics_explosion_power.min="0.05"
            physics_explosion_power.max="0.1"
            physics_throw_enabled="1"
            shake_vegetation="1"
            sparks_count_min="5"
            sparks_count_max="10"
            sparks_enabled="1"
            stains_enabled="1"
            stains_radius="10"
        ></config_explosion>
    </ExplodeOnDamageComponent>

    <PhysicsBodyCollisionDamageComponent
        _tags="enabled_in_world"
        speed_threshold="85.0"
    ></PhysicsBodyCollisionDamageComponent>

    <CameraBoundComponent
        _tags="enabled_in_world"
        max_count="100"
        distance="1000"
    ></CameraBoundComponent>

    <!-- The vanilla plasma spill, from a death script: a MaterialInventoryComponent would also spill it when the
         held lantern is replaced by a hung one. -->
    <LuaComponent script_death="mods/pick_up_your_lantern/files/scripts/temple_lantern_death.lua" />

    <LuaComponent script_damage_received="mods/pick_up_your_lantern/files/scripts/lantern_damage.lua" />

    <LuaComponent
        script_throw_item="mods/pick_up_your_lantern/files/scripts/lantern_throw.lua"
        execute_every_n_frame="-1"
    ></LuaComponent>

    <AudioComponent
        _tags="enabled_in_world"
        file="data/audio/Desktop/materials.bank"
        event_root="collision/lantern"
        set_latest_event_position="1"
    ></AudioComponent>

    <PhysicsThrowableComponent
        max_throw_speed="180"
        throw_force_coeff="1.5"
    ></PhysicsThrowableComponent>

    <ProjectileComponent
        _tags="enabled_in_world"
        lifetime="-1"
        damage="0"
        penetrate_entities="1"
        never_hit_player="1"
    ></ProjectileComponent>

    <VelocityComponent
        _tags="enabled_in_world"
    ></VelocityComponent>

    <SpriteComponent
        _tags="character,enabled_in_hand"
        _enabled="0"
        alpha="1"
        image_file="mods/pick_up_your_lantern/files/props_gfx/temple_lantern_in_hand.xml"
        offset_x="4.5"
        offset_y="0.5"
        emissive="0"
        additive="0"
        next_rect_animation=""
        rect_animation="default"
        z_index="-1.1"
        has_special_scale="1"
        special_scale_x="1"
        special_scale_y="1"
    ></SpriteComponent>

    <ItemComponent
        _tags="enabled_in_world"
        item_name="$item_temple_lantern"
        ui_description="$item_description_temple_lantern"
        ui_sprite="mods/pick_up_your_lantern/files/props_gfx/ui_temple_lantern.png"
        max_child_items="0"
        is_pickable="1"
        is_equipable_forced="1"
        preferred_inventory="QUICK"
        drinkable="0"
    ></ItemComponent>

    <UIInfoComponent
        _tags="enabled_in_world"
        name="$item_temple_lantern"
    ></UIInfoComponent>

    <AbilityComponent
        ui_name="$item_temple_lantern"
        throw_as_item="1"
    >
        <gun_config deck_capacity="0" />
    </AbilityComponent>

    <VariableStorageComponent
        _tags="enabled_in_world,enabled_in_hand,enabled_in_inventory"
        name="lantern_swing_angle"
        value_float="0"
    ></VariableStorageComponent>

    <VariableStorageComponent
        _tags="enabled_in_world,enabled_in_hand,enabled_in_inventory"
        name="lantern_swing_vel"
        value_float="0"
    ></VariableStorageComponent>

    <VariableStorageComponent
        _tags="enabled_in_world,enabled_in_hand,enabled_in_inventory"
        name="lantern_swing_phase"
        value_float="0"
    ></VariableStorageComponent>

    <LuaComponent
        _tags="enabled_in_hand"
        _enabled="0"
        execute_every_n_frame="1"
        script_source_file="mods/pick_up_your_lantern/files/scripts/lantern_in_hand.lua"
    ></LuaComponent>

</Entity>
