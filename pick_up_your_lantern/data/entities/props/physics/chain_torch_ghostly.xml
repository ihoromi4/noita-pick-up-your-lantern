<Entity tags="mortal,hittable,teleportable_NOT,prop,prop_physics,item_physics,item_pickup,lantern,pul_light_source" >

    <!-- A pickable chain torch; the shared part is in files/entities/base_chain_torch_item.xml. -->
    <Base file="mods/pick_up_your_lantern/files/entities/base_chain_torch_item.xml" />

    <!-- Base light of this torch type, at the coals. Radius is scaled at runtime by settings, quality tier and
         modifier; 0 while the torch is doused. Teal, as its sparks. -->
    <LightComponent
        _tags="enabled_in_world,enabled_in_hand,pul_light_source"
        _enabled="1"
        radius="96"
        offset_y="6"
        fade_out_time="1.5"
        r="80" g="255" b="190"
        update_properties="1"
    ></LightComponent>

    <!-- The spark emitters of data/entities/base_torch_particle.xml in the colour of this torch type, moved down
         to the coals, in the world only. -->
    <ParticleEmitterComponent
        _tags="enabled_in_world"
        color="ff50efe7"
        emitted_material_name="spark_green"
        custom_style="FIRE"
        offset.x="0"
        offset.y="6"
        x_pos_offset_min="-2"
        x_pos_offset_max="2"
        y_pos_offset_min="0"
        y_pos_offset_max="2"
        x_vel_min="-2"
        x_vel_max="2"
        y_vel_min="-20"
        y_vel_max="-10"
        count_min="4"
        count_max="6"
        lifetime_min="0.3"
        lifetime_max="0.4"
        create_real_particles="1"
        emit_cosmetic_particles="0"
        emission_interval_min_frames="1"
        emission_interval_max_frames="3"
        is_emitting="1"
    ></ParticleEmitterComponent>

    <ParticleEmitterComponent
        _tags="enabled_in_world"
        emitted_material_name="spark_green"
        offset.x="0"
        offset.y="6"
        x_pos_offset_min="-2"
        x_pos_offset_max="2"
        y_pos_offset_min="0"
        y_pos_offset_max="2"
        x_vel_min="-2"
        x_vel_max="2"
        y_vel_min="-20"
        y_vel_max="-10"
        count_min="1"
        count_max="2"
        lifetime_min="0.3"
        lifetime_max="0.4"
        create_real_particles="1"
        emit_cosmetic_particles="0"
        emission_interval_min_frames="2"
        emission_interval_max_frames="6"
        is_emitting="1"
    ></ParticleEmitterComponent>

    <SpriteComponent
        _tags="character,enabled_in_hand"
        _enabled="0"
        alpha="1"
        image_file="mods/pick_up_your_lantern/files/props_gfx/chain_torch_ghostly_in_hand.xml"
        offset_x="5.5"
        offset_y="0.5"
        emissive="0"
        additive="0"
        next_rect_animation=""
        rect_animation="default"
        z_index="-1.1"
        has_special_scale="1"
        special_scale_x="0.6"
        special_scale_y="0.6"
    ></SpriteComponent>

    <ItemComponent
        _tags="enabled_in_world"
        item_name="$item_chain_torch_ghostly"
        ui_description="$item_description_chain_torch_ghostly"
        ui_sprite="mods/pick_up_your_lantern/files/props_gfx/ui_chain_torch_ghostly.png"
        max_child_items="0"
        is_pickable="1"
        is_equipable_forced="1"
        preferred_inventory="QUICK"
        drinkable="0"
    ></ItemComponent>

    <UIInfoComponent
        _tags="enabled_in_world"
        name="$item_chain_torch_ghostly"
    ></UIInfoComponent>

    <AbilityComponent
        ui_name="$item_chain_torch_ghostly"
        throw_as_item="1"
    >
        <gun_config deck_capacity="0" />
    </AbilityComponent>

</Entity>
