<Entity tags="mortal,hittable,teleportable_NOT,prop,prop_physics,item_physics,item_pickup,lantern,pul_light_source" >

    <!-- mortal is required so it can explode -->

    <PhysicsBodyComponent
        _tags="enabled_in_world"
        allow_sleep="1"
        angular_damping="0.01"
        fixed_rotation="0"
        gridworld_box2d="1"
        hax_fix_going_through_ground="1"
        is_bullet="1"
        linear_damping="0.3"
        auto_clean="0"
        on_death_leave_physics_body="0"
        on_death_really_leave_body="0"
    ></PhysicsBodyComponent>

    <!-- Origin at the top of the bail, where the vanilla chain is attached. -->
    <PhysicsImageShapeComponent
        centered="0"
        offset_x="5.5"
        offset_y="0.5"
        image_file="data/props_gfx/torch_hang_unlit.png"
        material="metal_nohit"
    ></PhysicsImageShapeComponent>

    <!-- Holds a torch right under the ceiling, hung with the left mouse button, or at the end of its short chain,
         where lantern_chain.lua spawns a torch spawned by a biome again: the joint pins the top of the bail in the
         air there. lantern_chain.lua removes it when the torch comes off the chain. -->
    <PhysicsJointComponent
        nail_to_wall="1"
        breakable="1"
        pos_x="5.5"
        pos_y="1"
    ></PhysicsJointComponent>

    <LuaComponent
        _tags="enabled_in_world"
        execute_every_n_frame="20"
        script_source_file="mods/pick_up_your_lantern/files/scripts/lantern_anchor.lua"
        script_kick="mods/pick_up_your_lantern/files/scripts/lantern_anchor.lua"
    ></LuaComponent>

    <!-- Kicked off its chain. -->
    <LuaComponent
        _tags="enabled_in_world"
        execute_every_n_frame="-1"
        script_kick="mods/pick_up_your_lantern/files/scripts/lantern_chain_kick.lua"
    ></LuaComponent>

    <LuaComponent
        _tags="enabled_in_world"
        execute_every_n_frame="1"
        script_source_file="mods/pick_up_your_lantern/files/scripts/lantern_in_world.lua"
    ></LuaComponent>

    <!-- Base light of this torch type, at the coals. Radius is scaled at runtime by settings, quality tier and
         modifier; 0 while the torch is doused. Light blue, as its sparks. -->
    <LightComponent
        _tags="enabled_in_world,enabled_in_hand,pul_light_source"
        _enabled="1"
        radius="96"
        offset_y="6"
        fade_out_time="1.5"
        r="90" g="200" b="255"
        update_properties="1"
    ></LightComponent>

    <!-- Base fog of war hole of this torch type. Removed on init when dynamic lighting is disabled. -->
    <SpriteComponent
        _tags="enabled_in_world,enabled_in_hand"
        _enabled="1"
        alpha="0.55"
        image_file="data/particles/fog_of_war_hole_64.xml"
        smooth_filtering="1"
        fog_of_war_hole="1"
        has_special_scale="1"
        special_scale_x="0.8"
        special_scale_y="0.8"
    ></SpriteComponent>

    <!-- Fire in hand, dousing in liquids and lighting again from fire. Replaces the vanilla TorchComponent, which
         went out in solid materials too and was lit again by the item system when picked up. -->
    <LuaComponent
        _tags="enabled_in_world,enabled_in_hand"
        execute_every_n_frame="1"
        script_source_file="mods/pick_up_your_lantern/files/scripts/chain_torch_fire.lua"
    ></LuaComponent>

    <!-- The vanilla torch particles (data/entities/base_torch_particle.xml), moved down to the coals, in the world
         only: in hand chain_torch_fire.lua makes the fire. The fire emitter makes real fire cells that set burning
         materials around alight; they do not ignite creatures. -->
    <ParticleEmitterComponent
        _tags="enabled_in_world"
        emitted_material_name="smoke"
        offset.x="0"
        offset.y="6"
        x_pos_offset_min="-2"
        x_pos_offset_max="2"
        y_pos_offset_min="0"
        y_pos_offset_max="2"
        x_vel_min="-10"
        x_vel_max="10"
        y_vel_min="-10"
        y_vel_max="10"
        count_min="5"
        count_max="5"
        lifetime_min="0.1"
        lifetime_max="0.3"
        create_real_particles="1"
        emit_cosmetic_particles="0"
        emission_interval_min_frames="60"
        emission_interval_max_frames="250"
        is_emitting="1"
    ></ParticleEmitterComponent>

    <ParticleEmitterComponent
        _tags="enabled_in_world"
        color="ff50e7f0"
        emitted_material_name="spark_blue"
        custom_style="FIRE"
        offset.x="0"
        offset.y="6"
        x_pos_offset_min="-2"
        x_pos_offset_max="2"
        y_pos_offset_min="0"
        y_pos_offset_max="2"
        x_vel_min="-2"
        x_vel_max="2"
        y_vel_min="-20"
        y_vel_max="-10"
        count_min="4"
        count_max="6"
        lifetime_min="0.3"
        lifetime_max="0.4"
        create_real_particles="1"
        emit_cosmetic_particles="0"
        emission_interval_min_frames="1"
        emission_interval_max_frames="3"
        is_emitting="1"
    ></ParticleEmitterComponent>

    <ParticleEmitterComponent
        _tags="enabled_in_world"
        emitted_material_name="spark_blue"
        offset.x="0"
        offset.y="6"
        x_pos_offset_min="-2"
        x_pos_offset_max="2"
        y_pos_offset_min="0"
        y_pos_offset_max="2"
        x_vel_min="-2"
        x_vel_max="2"
        y_vel_min="-20"
        y_vel_max="-10"
        count_min="1"
        count_max="2"
        lifetime_min="0.3"
        lifetime_max="0.4"
        create_real_particles="1"
        emit_cosmetic_particles="0"
        emission_interval_min_frames="2"
        emission_interval_max_frames="6"
        is_emitting="1"
    ></ParticleEmitterComponent>

    <ParticleEmitterComponent
        _tags="enabled_in_world"
        emitted_material_name="fire"
        offset.x="0"
        offset.y="6"
        x_pos_offset_min="-1"
        x_pos_offset_max="1"
        y_pos_offset_min="-1"
        y_pos_offset_max="1"
        x_vel_min="-2"
        x_vel_max="2"
        y_vel_min="-20"
        y_vel_max="-10"
        count_min="1"
        count_max="2"
        lifetime_min="0.3"
        lifetime_max="0.4"
        create_real_particles="1"
        emit_cosmetic_particles="0"
        emission_interval_min_frames="2"
        emission_interval_max_frames="6"
        fire_cells_dont_ignite_damagemodel="1"
        is_emitting="1"
    ></ParticleEmitterComponent>

    <DamageModelComponent
        _tags="enabled_in_world"
        air_needed="0"
        blood_material="spark"
        blood_multiplier="0"
        drop_items_on_death="0"
        falling_damage_damage_max="1.2"
        falling_damage_damage_min="0.1"
        falling_damage_height_max="250"
        falling_damage_height_min="70"
        falling_damages="0"
        fire_damage_amount="0"
        fire_probability_of_ignition="0"
        critical_damage_resistance="1"
        hp="0.5"
        is_on_fire="0"
        materials_create_messages="0"
        materials_damage="0"
        ragdoll_filenames_file=""
        ragdoll_material=""
        ui_report_damage="0"
    ></DamageModelComponent>

    <!-- A small pop without a hole; chain_torch_death.lua scatters the fire. -->
    <ExplodeOnDamageComponent
        _tags="enabled_in_world"
        explode_on_death_percent="1"
        explode_on_damage_percent="0.0"
        physics_body_modified_death_probability="0.75"
        physics_body_destruction_required="0.5"
    >
        <config_explosion
            never_cache="0"
            damage="0.1"
            camera_shake="0.5"
            explosion_radius="4"
            explosion_sprite="data/particles/explosion_008.xml"
            explosion_sprite_lifetime="8"
            create_cell_probability="0"
            hole_destroy_liquid="0"
            hole_enabled="0"
            ray_energy="0"
            particle_effect="1"
            damage_mortals="1"
            physics_explosion_power.min="0.05"
            physics_explosion_power.max="0.1"
            physics_throw_enabled="1"
            shake_vegetation="1"
            sparks_count_min="5"
            sparks_count_max="10"
            sparks_enabled="1"
            stains_enabled="0"
        ></config_explosion>
    </ExplodeOnDamageComponent>

    <PhysicsBodyCollisionDamageComponent
        _tags="enabled_in_world"
        speed_threshold="85.0"
    ></PhysicsBodyCollisionDamageComponent>

    <CameraBoundComponent
        _tags="enabled_in_world"
        max_count="100"
        distance="1000"
    ></CameraBoundComponent>

    <!-- Spark material of this torch type, scattered on death by chain_torch_death.lua. -->
    <VariableStorageComponent
        name="chain_torch_spark_material"
        value_string="spark_blue"
    ></VariableStorageComponent>

    <LuaComponent script_death="mods/pick_up_your_lantern/files/scripts/chain_torch_death.lua" />

    <LuaComponent script_damage_received="mods/pick_up_your_lantern/files/scripts/lantern_damage.lua" />

    <LuaComponent
        script_throw_item="mods/pick_up_your_lantern/files/scripts/lantern_throw.lua"
        execute_every_n_frame="-1"
    ></LuaComponent>

    <AudioComponent
        _tags="enabled_in_world"
        file="data/audio/Desktop/materials.bank"
        event_root="collision/metalhollow"
        set_latest_event_position="1"
    ></AudioComponent>

    <PhysicsThrowableComponent
        max_throw_speed="180"
        throw_force_coeff="1.5"
    ></PhysicsThrowableComponent>

    <ProjectileComponent
        _tags="enabled_in_world"
        lifetime="-1"
        damage="0"
        penetrate_entities="1"
        never_hit_player="1"
    ></ProjectileComponent>

    <VelocityComponent
        _tags="enabled_in_world"
    ></VelocityComponent>

    <SpriteComponent
        _tags="character,enabled_in_hand"
        _enabled="0"
        alpha="1"
        image_file="mods/pick_up_your_lantern/files/props_gfx/chain_torch_blue_in_hand.xml"
        offset_x="5.5"
        offset_y="0.5"
        emissive="0"
        additive="0"
        next_rect_animation=""
        rect_animation="default"
        z_index="-1.1"
        has_special_scale="1"
        special_scale_x="0.6"
        special_scale_y="0.6"
    ></SpriteComponent>

    <ItemComponent
        _tags="enabled_in_world"
        item_name="$item_chain_torch_blue"
        ui_description="$item_description_chain_torch_blue"
        ui_sprite="mods/pick_up_your_lantern/files/props_gfx/ui_chain_torch_blue.png"
        max_child_items="0"
        is_pickable="1"
        is_equipable_forced="1"
        preferred_inventory="QUICK"
        drinkable="0"
    ></ItemComponent>

    <UIInfoComponent
        _tags="enabled_in_world"
        name="$item_chain_torch_blue"
    ></UIInfoComponent>

    <AbilityComponent
        ui_name="$item_chain_torch_blue"
        throw_as_item="1"
    >
        <gun_config deck_capacity="0" />
    </AbilityComponent>

    <VariableStorageComponent
        _tags="enabled_in_world,enabled_in_hand,enabled_in_inventory"
        name="lantern_swing_angle"
        value_float="0"
    ></VariableStorageComponent>

    <VariableStorageComponent
        _tags="enabled_in_world,enabled_in_hand,enabled_in_inventory"
        name="lantern_swing_vel"
        value_float="0"
    ></VariableStorageComponent>

    <VariableStorageComponent
        _tags="enabled_in_world,enabled_in_hand,enabled_in_inventory"
        name="lantern_swing_phase"
        value_float="0"
    ></VariableStorageComponent>

    <LuaComponent
        _tags="enabled_in_hand"
        _enabled="0"
        execute_every_n_frame="1"
        script_source_file="mods/pick_up_your_lantern/files/scripts/lantern_in_hand.lua"
    ></LuaComponent>

</Entity>
