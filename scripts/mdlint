#!/bin/sh
# Lint the Markdown files of the mod with markdownlint-cli2.
# The script wraps tools/noitakit/scripts/mdlint, so the rules come from
# tools/noitakit/.markdownlint-cli2.jsonc in the DevKit submodule.
# With arguments, lint only the given files. A relative path is resolved
# against the directory from which the script is called.
# With no arguments, lint all Markdown files of the mod that Git tracks or
# would track, without the files of the DevKit and the ignored folders.
root=$(cd "$(dirname "$0")/.." && pwd) || exit 1
devkit_mdlint="$root/tools/noitakit/scripts/mdlint"
if [ "$#" -gt 0 ]; then
    exec "$devkit_mdlint" "$@"
fi
cd "$root" || exit 1
git ls-files -z --cached --others --exclude-standard -- '*.md' ':!tools' \
    | xargs -0 -r "$devkit_mdlint"
